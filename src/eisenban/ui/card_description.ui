              <item>
               <widget class="QComboBox" name="importantComboBox">
                <property name="styleSheet">
                 <string notr="true">/* Base style */
QComboBox {
    background-color: #6badee;
    color: #ffffff;
    border: 1px solid transparent;
    border-radius: 5px;
    padding: 4px 8px;
    min-height: 20px;
}

/* Hover */
QComboBox:hover {
    background-color: #5487bb;
}

/* Focus */
QComboBox:focus {
    border: 1.5px solid #000000;
    outline: none;
}

/* Disabled */
QComboBox:disabled {
    background-color: #a0c4e8;
    color: #e0e0e0;
}

/* Drop-down button */
QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 24px;
    border-left: 1px solid rgba(255, 255, 255, 0.3);
    border-top-right-radius: 5px;
    border-bottom-right-radius: 5px;
    background-color: transparent;
}

/* Drop-down button hover */
QComboBox::drop-down:hover {
    background-color: rgba(0, 0, 0, 0.1);
}

/* Arrow */
QComboBox::down-arrow {
    image: none;
    width: 12px;
    height: 12px;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 6px solid #ffffff;
}

/* Popup list container */
QComboBox QAbstractItemView {
    background-color: #6badee;          /* same blue as the combobox */
    color: #ffffff;
    border: 1px solid #5487bb;
    border-radius: 5px;
    outline: none;
    selection-background-color: #5487bb;
    selection-color: #ffffff;
}

/* All items in the list */
QComboBox QAbstractItemView::item {
    background-color: #6badee;          /* base color */
    color: #ffffff;
    padding: 6px 10px;
    min-height: 24px;
    border-radius: 3px;                 /* optional, looks nicer */
}

/* Hovered item */
QComboBox QAbstractItemView::item:hover {
    background-color: #5487bb;          /* same as combobox hover */
    color: #ffffff;
}

/* Selected / current item */
QComboBox QAbstractItemView::item:selected {
    background-color: #5487bb;
    color: #ffffff;
}

/* Disabled items (if any) */
QComboBox QAbstractItemView::item:disabled {
    background-color: #a0c4e8;
    color: #e0e0e0;
}</string>
