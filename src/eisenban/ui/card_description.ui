                <property name="styleSheet">
                 <string notr="true">QCalendarWidget QWidget {
	background-color: #6badee;
}

QCalendarWidget QAbstractItemView:!enabled {
	color: #cecece
}

QCalendarWidget QAbstractItemView:enabled {
	color: #000000
}

QCalendarWidget QToolButton {
	padding: 5px;
}

QCalendarWidget QMenu {
	background-color: #f5f5f5;
	border: none;
	padding: 2px;
	margin: 0px;
	font-size: 14px;
}

QCalendarWidget QMenu::item {
	padding: 5px;
}

QCalendarWidget QMenu::item:selected {
	background-color: #007bff;
	color: #ffffff;
}

QCalendarWidget QToolButton {
	icon-size: 18px;
}

QCalendarWidget QToolButton#qt_calendar_prevmonth {
	qproperty-icon: url(:/img/resources/img/left-arrow.png);
}

QCalendarWidget QToolButton#qt_calendar_nextmonth {
	qproperty-icon: url(:/img/resources/img/right-arrow.png);
}

QCalendarWidget QToolButton:pressed {
	background-color: #007bff;
}

QCalendarWidget QSpinBox {
	border: none;
	color: #000000;
}

QCalendarWidget QSpinBox::up-button,
QCalendarWidget QSpinBox::down-button {
	border-radius: 5px;
}

QCalendarWidget QSpinBox::up-arrow {
	image: url(:/img/resources/img/up-arrow.png);
	width: 10px;
	height: 10px
}

QCalendarWidget QSpinBox::down-arrow {
	image: url(:/img/resources/img/down-arrow.png);
	width: 10px;
	height: 10px
}

QCalendarWidget QSpinBox::up-arrow:pressed,
QCalendarWidget QSpinBox::down-arrow:pressed {
	width: 7px;
	height: 7px;
}
</string>
